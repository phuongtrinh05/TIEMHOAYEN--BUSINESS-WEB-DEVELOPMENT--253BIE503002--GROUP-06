PORT=3000
CORS_ORIGINS=http://localhost:4200
PUBLIC_BASE_URL=http://localhost:3000
PASSWORD_HASH_ROUNDS=12
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
MONGO_DATABASE=TIEM_HOA_YEN
MIGRATION_BATCH_SIZE=500
API_key=YOUR_API_KEY
# Direct chatbot (Groq). FAQ matching still works without a configured AI key.
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-20b
# Kho (tùy chọn) — xem INVENTORY_README.md
# INVENTORY_HOLD_MINUTES=5
# INVENTORY_SAME_DAY_CUTOFF=14:00
# INVENTORY_PRODUCT_LOW_STOCK=3
# Local UI review against an existing database: disable automatic inventory jobs/index bootstrap if needed.
# INVENTORY_BACKGROUND_JOBS=false
# INVENTORY_BOOTSTRAP_INDEXES=false

# Local-only OTP transport. Production requires a configured SMS delivery service.
ORDER_OTP_DELIVERY=console

# Marketing: bật tiến trình tự động kiểm tra và gửi thông báo/email.
MARKETING_BACKGROUND_JOBS=true

# Google Apps Script dùng để gửi email marketing bằng Gmail của shop.
# URL phải là Web App URL kết thúc bằng /exec.
APPS_SCRIPT_MARKETING_URL=

# Phải giống MARKETING_SHARED_SECRET trong Apps Script.
# Không ghi secret thật vào file này hoặc đẩy lên GitHub.
APPS_SCRIPT_MARKETING_SECRET=

# Tên hiển thị của người gửi.
MARKETING_EMAIL_FROM=Tiệm Hoa Yến

# Địa chỉ backend công khai, dùng tạo liên kết ngừng nhận quảng cáo.
# Khi chạy thật phải là HTTPS.
MARKETING_PUBLIC_URL=http://localhost:3000

# Authentication email via Gmail API (HTTPS, works with Render Free).
# Store actual values only in local .env / Render Environment, never in Git.
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional Apps Script HTTPS sender; takes precedence over Gmail OAuth.
APPS_SCRIPT_OTP_URL=
APPS_SCRIPT_OTP_SECRET=

# Optional Resend fallback for authentication emails only.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
